# Local development only. Do not use a production or Atlas URI here.
NODE_ENV=development
PORT=5000
MONGO_URL=mongodb://localhost:27017/beautyconnect
JWT_SECRET=replace_with_a_long_local_secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: image uploads return an explicit error until these are configured.
